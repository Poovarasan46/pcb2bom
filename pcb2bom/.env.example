# ==============================================================================
# pcb2bom Environment Variables
# Copy this file to .env and fill in your API credentials.
# Note: For evaluation or offline usage, use --mock mode which requires NO API keys.
# ==============================================================================

# Digi-Key API Credentials
# Obtain via Digi-Key Developer Portal: https://developer.digikey.com/
DIGIKEY_CLIENT_ID=your_digikey_client_id_here
DIGIKEY_CLIENT_SECRET=your_digikey_client_secret_here

# Octopart / Nexar API Credentials
# Obtain via Nexar Developer Portal: https://nexar.com/
OCTOPART_API_TOKEN=your_octopart_nexar_token_here
NEXAR_CLIENT_ID=your_nexar_client_id_here
NEXAR_CLIENT_SECRET=your_nexar_client_secret_here

# Cache and Network Settings
PCB2BOM_CACHE_DIR=~/.cache/pcb2bom
PCB2BOM_REQUEST_TIMEOUT=10
